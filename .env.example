# Copy to .env and edit. docker-compose reads these (all optional, with defaults).

# --- asset / task (competition: 1h log-return, 5-min cadence) ---
ALLORA_SYMBOL=BTC/USDT          # use ETH/USDT for the ETH topic
ALLORA_CROSS_SYMBOL=ETH/USDT    # reference asset for cross-asset features ("" to disable; use BTC/USDT for the ETH topic)
ALLORA_TOPIC_TOKEN=BTC
ALLORA_TIMEFRAME=5m
ALLORA_HORIZON_STEPS=12         # 12 * 5m = 1 hour

# --- data source ---
# binanceus only serves US IPs; outside the US use: binance / coinbase / kraken
ALLORA_EXCHANGE=binanceus

# --- alt-data features ---
# Real order flow from raw klines (taker-buy volume / CVD / trade intensity).
# Needs a binance-family exchange; degrades to neutral elsewhere.
ALLORA_USE_ORDERFLOW=true
# Futures positioning (funding rate + open interest). binanceus has NO futures, so
# these are pulled from ALLORA_FUTURES_EXCHANGE. Set ALLORA_FUTURES_SYMBOL="" to
# disable. Open-interest history is exchange-limited to ~30 days; funding goes back
# further -- recency weighting (below) leans on the period where both are present.
ALLORA_FUTURES_EXCHANGE=binance
# Futures (funding/OI) is OFF by default: walk-forward ablation showed it HURT 1h DA.
# Set BTC/USDT:USDT (ETH topic: ETH/USDT:USDT) to re-test via `python -m forge.research`.
ALLORA_FUTURES_SYMBOL=
# On-chain via Dune Analytics (see docs/ONCHAIN.md for the SQL to create the queries).
# Enabled only when the API key + at least one query id are set; degrades to neutral.
ALLORA_DUNE_API_KEY=
# ALLORA_DUNE_EXECUTE=false            # true = re-run queries each cycle (spends credits)
# ALLORA_DUNE_QUERY_STABLE_SUPPLY=
# ALLORA_DUNE_QUERY_CEX_NETFLOW=
# ALLORA_DUNE_QUERY_DEX_VOLUME=
# ALLORA_DUNE_QUERY_ACTIVE_ADDR=

# --- training ---
ALLORA_TRAIN_WINDOW_DAYS=365
ALLORA_RETRAIN_HOUR_UTC=1
# Sign-aware modeling: a directional classifier + regressor/classifier blends are
# trained alongside the regressors and the whitelist-best candidate wins.
ALLORA_USE_CLASSIFIER=true
ALLORA_USE_ENSEMBLE=true
# Exponential recency weighting (half-life in days) so the model tracks the current
# regime; 0 disables. Purge defaults to the horizon (12 bars) to stop boundary leak.
ALLORA_RECENCY_HALF_LIFE_DAYS=45
# ALLORA_PURGE_STEPS=12
# Variance calibration is searched automatically each cycle (the ratio that
# passes the most whitelist criteria is kept). Uncomment to PIN one ratio and
# disable the search: std(pred) ~= ratio * std(true); keep |log10(ratio)| < 0.5.
# ALLORA_CALIBRATION_RATIO=1.0

# --- ops ---
# Optional: POST training-failure / regression alerts here (e.g. Slack webhook).
ALLORA_ALERT_WEBHOOK=
